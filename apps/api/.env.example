# ==============================================================================
# FinLayer Core API — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env or any production secrets to source control.
# ==============================================================================

# ─── CORE SERVER & RUNTIME ───────────────────────────────────────────────────
# Node execution environment ("development" | "production" | "test")
# In production, ENCRYPTION_SECRET and ADMIN_API_KEY are strictly enforced.
NODE_ENV=development

# Server port to bind (default: 4000)
PORT=4000

# ─── DATABASE ────────────────────────────────────────────────────────────────
# PostgreSQL database connection string (used by Prisma & pg pool)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/finlayer?schema=public"

# ─── SECURITY & SECRETS ──────────────────────────────────────────────────────
# Symmetric encryption key (minimum 32 bytes recommended)
# Mandatory when NODE_ENV=production (runtime error thrown if unset)
# Used for encrypting connector tokens and sensitive tenant payloads.
ENCRYPTION_SECRET="change-this-to-a-secure-32-byte-hex-or-base64-secret"

# Master administrative API key for dashboard management endpoints
# Mandatory when NODE_ENV=production (admin endpoints reject if unset)
ADMIN_API_KEY="fl_admin_change_this_to_a_secure_random_key"

