{
  "name": "@finlayer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FinLayer Backend API — receives sync data from the connector agent",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "tsx test/security-saas-api.test.ts",
    "test:idempotency": "tsx test/voucher-idempotency.test.ts",
    "test:validation": "tsx test/accounting-validation.test.ts",
    "test:sync-audit": "tsx test/sync-run-and-audit.test.ts",
    "test:connector-auth": "tsx test/security-connector-auth.test.ts",
    "test:connector-registration": "tsx test/security-connector-registration.test.ts",
    "test:tenant-isolation": "tsx test/security-tenant-isolation.test.ts",
    "test:blockers": "tsx test/security-pairing-and-blockers.test.ts",
    "test:log-redaction": "tsx test/security-log-redaction.test.ts",
    "test:saas-api": "tsx test/security-saas-api.test.ts",
    "test:saas-sync": "tsx test/saas-triggered-sync.test.ts",
    "test:connector-reliability": "tsx test/connector-reliability-and-sync-status.test.ts",
    "verify-api": "tsx src/scripts/verify-api.ts",
    "key:create": "tsx src/scripts/create-api-key.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.3.3",
    "pg": "^8.23.0",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "prisma": "^7.10.0",
    "typescript": "^5.8.3"
  }
}
