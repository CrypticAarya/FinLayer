// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Company {
  id                String    @id @default(cuid())
  name              String
  tallyCompanyName  String    @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ledgers             Ledger[]
  syncLogs            SyncLog[]
  vouchers            Voucher[]
  syncRuns            SyncRun[]
  connectors          Connector[]
  mappings            SaasCompanyMapping[]
  trialBalanceEntries TrialBalanceEntry[]
  syncHistories       SyncHistory[]
  apiKeys             ApiKey[]
}

model Ledger {
  id        String   @id @default(cuid())
  companyId String
  name      String
  parent    String
  masterId  Int
  alterId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id])
  voucherEntries VoucherEntry[]

  @@unique([companyId, masterId])
  @@index([companyId])
}

model SyncLog {
  id        String   @id @default(cuid())
  companyId String
  created   Int
  updated   Int
  unchanged Int
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// ─── Sync Run & Audit Trail Models ────────────────────────────────────────────

model SyncRun {
  id               String         @id @default(cuid())
  companyId        String
  syncType         String         @default("VOUCHERS")
  status           String         @default("SYNC_STARTED") // SYNC_STARTED, SYNC_VALIDATING, SYNC_PROCESSING, SYNC_COMPLETED, SYNC_FAILED
  startedAt        DateTime       @default(now())
  completedAt      DateTime?
  durationMs       Int?
  recordsFetched   Int            @default(0)
  recordsCreated   Int            @default(0)
  recordsUpdated   Int            @default(0)
  recordsFailed    Int            @default(0)
  recordsProcessed Int            @default(0)
  errorSummary     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company   Company        @relation(fields: [companyId], references: [id])
  vouchers  Voucher[]
  auditLogs SyncAuditLog[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, startedAt])
  @@index([companyId, completedAt])
}

model SyncAuditLog {
  id        String   @id @default(cuid())
  syncRunId String
  stage     String   // SYNC_STARTED, SYNC_VALIDATING, SYNC_PROCESSING, SYNC_COMPLETED, SYNC_FAILED
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  syncRun SyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([syncRunId])
  @@index([syncRunId, createdAt])
}

// ─── Transaction Models ───────────────────────────────────────────────────────

model Voucher {
  id            String   @id @default(cuid())
  companyId     String
  masterId      Int
  alterId       Int
  guid          String?
  syncRunId     String?
  voucherNumber String
  voucherType   String
  date          DateTime
  partyName     String?
  amount        Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id])
  syncRun        SyncRun?       @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  voucherEntries VoucherEntry[]

  @@unique([companyId, masterId])
  @@index([companyId])
  @@index([date])
  @@index([companyId, voucherType])
  @@index([companyId, date, id])
  @@index([guid])
  @@index([syncRunId])
}

model VoucherEntry {
  id        String   @id @default(cuid())
  voucherId String
  ledgerId  String
  amount    Decimal  @db.Decimal(15, 2)
  type      String   // "debit" | "credit"
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id])
  ledger  Ledger  @relation(fields: [ledgerId], references: [id])

  @@index([voucherId])
  @@index([ledgerId])
}

// ─── Connector Models ─────────────────────────────────────────────────────────

model Connector {
  id               String               @id @default(cuid())
  companyId        String?
  name             String
  deviceId         String               @unique
  tokenHash        String?              @unique
  tokenCreatedAt   DateTime?
  tokenLastUsedAt  DateTime?
  tokenRevokedAt   DateTime?
  operatingSystem  String?
  status           String               @default("ONLINE")
  setupStatus      String               @default("REGISTERED")
  tallyCompanyName String?
  connectorVersion String?
  lastHeartbeat    DateTime             @default(now())
  lastSeenAt       DateTime?            @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  company    Company?             @relation(fields: [companyId], references: [id])
  syncJobs   SyncJob[]
  heartbeats ConnectorHeartbeat[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([tokenHash])
}

model ConnectorHeartbeat {
  id               String   @id @default(cuid())
  connectorId      String
  companyId        String?
  connectorVersion String?
  status           String   @default("ONLINE")
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId])
  @@index([companyId])
  @@index([lastSeenAt])
}

// ─── Sync Job Models ──────────────────────────────────────────────────────────

model SyncJob {
  id          String    @id @default(cuid())
  connectorId String
  type        String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  connector Connector @relation(fields: [connectorId], references: [id])

  @@index([connectorId])
  @@index([connectorId, status])
}

// ─── SaaS Developer Platform Models ──────────────────────────────────────────

model SaasApplication {
  id        String   @id @default(cuid())
  name      String
  apiKey    String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mappings SaasCompanyMapping[]
}

model SaasCompanyMapping {
  id                 String   @id @default(cuid())
  saasApplicationId  String
  companyId          String
  externalCustomerId String?
  createdAt          DateTime @default(now())

  saasApplication SaasApplication @relation(fields: [saasApplicationId], references: [id])
  company         Company         @relation(fields: [companyId], references: [id])

  @@unique([saasApplicationId, companyId])
  @@index([saasApplicationId])
  @@index([companyId])
  @@index([externalCustomerId])
}

// ─── SaaS API Key Models ──────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyPrefix  String
  keyHash    String    @unique
  companyId  String
  status     String    @default("ACTIVE") // "ACTIVE" | "REVOKED"
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([companyId])
  @@index([companyId, status])
}

// ─── Trial Balance Models ─────────────────────────────────────────────────────

model TrialBalanceEntry {
  id           String   @id @default(cuid())
  companyId    String
  ledgerName   String
  groupName    String
  debitAmount  Float
  creditAmount Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, ledgerName])
  @@index([companyId])
}


// ─── Sync History Models ───────────────────────────────────────────────────

model SyncHistory {
  id             String    @id @default(cuid())
  companyId      String
  syncType       String    // "FINANCIAL_DATA"
  status         String    // "IN_PROGRESS" | "SUCCESS" | "FAILED"
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  recordsUpdated Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, createdAt])
}




